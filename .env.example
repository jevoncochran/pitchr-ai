# Copy this file to .env and fill in real values. Never commit .env.

# From console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# Optional: override the Claude model (defaults to claude-sonnet-5-5)
# CLAUDE_MODEL=claude-sonnet-5-5

# Optional: the model that reads business cards (defaults to CLAUDE_MODEL)
# BUSINESS_CARD_SCAN_MODEL=

# Shared secret NestJS sends in the X-Internal-Api-Key header. Must match
# PITCHR_AI_API_KEY in pitchr-server. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
PITCHR_AI_API_KEY=
